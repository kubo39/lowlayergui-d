name "lowlayergui"
description "Low-layer GUI implementation in D."
authors "Hiroki Noda"
copyright "Copyright © 2026, Hiroki Noda"
license "BSL-1.0"
targetType "executable"

dependency "erupted"        version="~>2.1"
dependency "wayland:client" version="~>0.4"

subConfiguration "wayland:client" "static"
libs "wayland-client"

libs "vulkan" "harfbuzz" "xkbcommon" "icuuc" "icui18n" "freetype"

lflags "-rpath=/usr/lib/x86_64-linux-gnu"

stringImportPaths "gen"

preGenerateCommands \
    "mkdir -p gen" \
    "dub run wayland:scanner -- -c client -m xdg_shell -i /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml -o gen/xdg_shell.d" \
    "dub run wayland:scanner -- -c client -m text_input_unstable_v3 -i /usr/share/wayland-protocols/unstable/text-input/text-input-unstable-v3.xml -o gen/text_input_unstable_v3.d" \
    "glslangValidator -V --target-env vulkan1.1 -o gen/rect.vert.spv shaders/rect.vert" \
    "glslangValidator -V --target-env vulkan1.1 -o gen/rect.frag.spv shaders/rect.frag" \
    "glslangValidator -V --target-env vulkan1.1 -o gen/glyph.vert.spv shaders/glyph.vert" \
    "glslangValidator -V --target-env vulkan1.1 -o gen/glyph.frag.spv shaders/glyph.frag"

sourcePaths "source" "gen"

buildRequirements "allowWarnings"

buildType "debug" {
    buildOptions "debugMode" "debugInfo"
}

buildType "release" {
    buildOptions "releaseMode" "optimize" "inline"
}
